<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Ueci.Core</AssemblyName>
    <RootNamespace>Ueci</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Vfs/Linux/ueci-fuse-helper.c" />
    <EmbeddedResource Include="Vfs/Profiles/*.seed" />
  </ItemGroup>
  <ItemGroup>
    <!-- The managed adapter is loaded only by the Windows/WinFsp backend. The signed WinFsp
         driver itself remains an explicit machine prerequisite. -->
    <PackageReference Include="winfsp.net" Version="2.2.26215" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ueci.Tests" />
  </ItemGroup>
</Project>
